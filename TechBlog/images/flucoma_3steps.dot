// 「学習」は3つの操作に分かれる（①例集め ②fit ③predict）
digraph flucoma_3steps {
    graph [
        rankdir=LR
        bgcolor="transparent"
        fontname="Helvetica Neue"
        fontsize=11
        pad=0.5
        nodesep=0.5
        ranksep=0.9
    ]
    node [
        fontname="Helvetica Neue"
        fontsize=11
        style="filled,rounded"
        shape=box
        penwidth=0
        margin="0.22,0.16"
    ]
    edge [
        fontname="Helvetica Neue"
        fontsize=9
        penwidth=1.4
        arrowsize=0.7
        color="#94a3b8"
    ]

    step1 [label="① 例集め\n音を鳴らしながら\nAdd example を連打\n\n【手動】" fillcolor="#fef3c7" fontcolor="#92400e"]
    step2 [label="② 学習 fit\nerror が下がりきるまで\nfit を反復クリック\n\n【手動】" fillcolor="#fef3c7" fontcolor="#92400e"]
    step3 [label="③ 判別 predict\nトグルON → qmetro で\n50msごとに自動予測\n\n【自動】" fillcolor="#dbeafe" fontcolor="#1e40af"]

    r1 [label="教材が1件ずつ増える\n（まだ賢くない）" shape=plaintext fontcolor="#6b7280" fontsize=9 style=""]
    r2 [label="ネットワークが賢くなる" shape=plaintext fontcolor="#6b7280" fontsize=9 style=""]
    r3 [label="鳴らすと音色を判定" shape=plaintext fontcolor="#6b7280" fontsize=9 style=""]

    step1 -> step2 -> step3

    { rank=same; step1; r1 }
    { rank=same; step2; r2 }
    { rank=same; step3; r3 }
    step1 -> r1 [style=invis]
    step2 -> r2 [style=invis]
    step3 -> r3 [style=invis]
}
