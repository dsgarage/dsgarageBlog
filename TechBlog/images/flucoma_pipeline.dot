// FluCoMa 音色分類パイプライン全体像
digraph flucoma_pipeline {
    graph [
        rankdir=LR
        bgcolor="transparent"
        fontname="Helvetica Neue"
        fontsize=11
        pad=0.5
        nodesep=0.45
        ranksep=0.85
    ]
    node [
        fontname="Helvetica Neue"
        fontsize=11
        style="filled,rounded"
        shape=box
        penwidth=0
        margin="0.20,0.14"
    ]
    edge [
        fontname="Helvetica Neue"
        fontsize=9
        penwidth=1.4
        arrowsize=0.7
        color="#94a3b8"
        fontcolor="#6b7280"
    ]

    src   [label="音源\n(playlist~)"            fillcolor="#f3f4f6" fontcolor="#4b5563"]
    mfcc  [label="fluid.mfcc~\n音色を13個の数値へ" fillcolor="#dbeafe" fontcolor="#1e40af"]
    store [label="fluid.dataset~ /\nfluid.labelset~\nデータ＋正解ラベルを保存" fillcolor="#dbeafe" fontcolor="#1e40af"]
    mlp   [label="fluid.mlpclassifier~\n学習(fit)・判別(predict)" fillcolor="#fef3c7" fontcolor="#92400e"]
    out   [label="判別結果\ntrombone / oboe"        fillcolor="#f3f4f6" fontcolor="#4b5563"]

    src   -> mfcc  [label="音"]
    mfcc  -> store [label="MFCC"]
    store -> mlp   [label="学習データ"]
    mlp   -> out   [label="予測"]
}
